# ---- Telephony: SignalWire or Telnyx ----
# If SignalWire credentials are set, bot.py automatically routes via SignalWire (+15075010702).
SIGNALWIRE_SPACE_URL=https://your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_PHONE_NUMBER=

# Alternatively, Telnyx:
# TELNYX_API_KEY=
# TELNYX_ACCOUNT_SID=
# TELNYX_TEXML_APP_ID=


# ---- STT + TTS: Cartesia (both stages use the same key) ----
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49

# ---- LLM: pick one (both require an API key) ----
LLM_PROVIDER=openai              # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-2026-03-05
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Scheduling: Cal.com (no plan-tier restriction on booking creation) ----
# API key from Cal.com's Settings -> Security -> API Keys page — doesn't expire.
# Test-mode keys start with cal_, live-mode keys with cal_live_.
CAL_API_KEY=
# Create your Event Type in Cal.com's UI first, with a video conferencing location (Google
# Meet or Zoom) enabled. Then paste its PUBLIC BOOKING URL here — the one you'd give a
# customer to book directly, e.g. https://cal.com/your-username/your-event-slug. This one
# event type is used for both Sales and Support (same as the prior Calendly setup).
CAL_BOOKING_URL=
CAL_LOOKAHEAD_DAYS=14

# IANA timezone for all date/time display and the Cal.com attendee timezone, e.g.
# "Europe/London", "America/New_York". Get this wrong and every booked meeting will be at
# the wrong time.
TIMEZONE=UTC

# ---- PARKED / UNUSED — earlier scheduling attempts ----
# Kept in the project (google_sheets.py, google_calendar.py, calendly.py, email_sender.py)
# in case Cal.com doesn't work out either. Not read by any active code path right now.
# CALENDLY_API_KEY=
# CALENDLY_SALES_EVENT_TYPE_URI=
# CALENDLY_SUPPORT_EVENT_TYPE_URI=
# CALENDLY_LOOKAHEAD_DAYS=14
# CALENDLY_BOOKING_URL=
# GOOGLE_SHEETS_CREDENTIALS_PATH=./service-account.json
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_SALES_TAB=Sales_Slots
# GOOGLE_SHEETS_SUPPORT_TAB=Support_Slots
# GOOGLE_CALENDAR_ID_SALES=
# GOOGLE_CALENDAR_ID_SUPPORT=
# MEETING_DURATION_MINUTES=30
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=

# ---- Supabase: customer lookup (cross-sell), warm leads, meeting audit log ----
SUPABASE_URL=
# Service role key, NOT the public anon key — see booking_db.py for why.
SUPABASE_SERVICE_KEY=

LOG_LEVEL=INFO

# ---- Optional: audio quality ----
# Background noise suppression (fans, traffic, TV) on incoming caller audio — free, fully
# local, no account needed. Enabled automatically if you've run:
#   pip install "pipecat-ai[rnnoise]"
# (already included in requirements.txt). No env var needed; bot.py detects it at startup
# and logs a warning if it's missing, but still runs fine either way.
#
# RNNoise reduces general ambient NOISE. If your real problem is a second clear human voice
# audible near the caller (not just background hum), that's a harder problem — true voice
# ISOLATION — that RNNoise isn't designed for. Krisp VIVA, Arctan Eigen, and the AIC filter
# all do this properly, but each requires signing up for a separate paid SDK license before
# any code here could use it. See PROJECT_DOCUMENTATION.md for links if you need to go there.

# ---- Live call transfer (transfer_to_human) ----
# When caller asks for a human/team member, bot initiates a live transfer via Telnyx Call Control.
TRANSFER_PHONE_NUMBER=+19177954404
TELNYX_PHONE_NUMBER=+18555010702

