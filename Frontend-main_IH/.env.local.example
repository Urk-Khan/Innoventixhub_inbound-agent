# Primary database connection string (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Legacy Supabase (fallback if DATABASE_URL is not set)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared password for accessing this dashboard. There's no per-user login — anyone with this
# password sees all call transcripts, customer names, phone numbers and emails, so treat it
# like any other credential (don't reuse a personal password, rotate it if it leaks).
ADMIN_PASSWORD=

# Used to sign the login session cookie so it can't be forged. Generate a random 32+ character
# string once (e.g. `openssl rand -hex 32`) and never change it without expecting everyone to
# be logged out.
SESSION_SECRET=
