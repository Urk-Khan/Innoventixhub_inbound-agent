# Same Supabase project as the voice agent's booking_db.py. This dashboard is READ-ONLY
# against calls/meetings, and only writes lead status updates — nothing here touches the
# voice agent's own tables in a way it doesn't already expect.
#
# SUPABASE_SERVICE_KEY must be the service-role key (same one the voice agent's .env uses).
# It is only ever read on the server (page Server Components and Server Actions) — never
# sent to the browser. Do not rename these with a NEXT_PUBLIC_ prefix, which would bundle
# them into client-side JS and expose them publicly.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared password for accessing this dashboard. There's no per-user login — anyone with this
# password sees all call transcripts, customer names, phone numbers and emails, so treat it
# like any other credential (don't reuse a personal password, rotate it if it leaks).
ADMIN_PASSWORD=

# Used to sign the login session cookie so it can't be forged. Generate a random 32+ character
# string once (e.g. `openssl rand -hex 32`) and never change it without expecting everyone to
# be logged out.
SESSION_SECRET=
